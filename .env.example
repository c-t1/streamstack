# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017)
MONGODB_URI=
DB_NAME=streamstack

# Any long random string. Signs the login cookie.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# TMDB v3 API key: themoviedb.org -> Settings -> API
TMDB_API_KEY=
